# ============================================
# Health Tracker Application - Environment Configuration
# Copy this file to .env and replace with actual values
# ============================================

# ===== NODE ENVIRONMENT =====
NODE_ENV=development
PORT=5001
LOG_LEVEL=debug

# ===== FIREBASE CONFIGURATION =====
# Web API Key (from Firebase Console)
FIREBASE_API_KEY=your_firebase_web_api_key_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Firebase Admin SDK - Service Account
# Get these from: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
FIREBASE_CLIENT_EMAIL=service-account@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/...
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Firebase Emulator (optional, for local development)
USE_FIREBASE_EMULATOR=0
FIREBASE_EMULATOR_HOST=127.0.0.1:9099

# ===== AUTHENTICATION SECRETS =====
# Generate strong secrets: openssl rand -base64 32
JWT_SECRET=replace_with_a_strong_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_strong_secret_min_32_chars
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# ===== OAUTH PROVIDERS =====
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ===== CACHING (REDIS) =====
# For local development, use: redis-server
# For production, use managed Redis service
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL_MINUTES=30

# ===== EMAIL SERVICE =====
# Option 1: Gmail SMTP (App Passwords)
GMAIL_USER=your_gmail@gmail.com
GMAIL_PASSWORD=your_gmail_app_password

# Option 2: SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@health-tracker.com

# Email Configuration
MAIL_SERVICE=gmail
EMAIL_FROM_NAME=Health Tracker
PASSWORD_RESET_URL=https://your-app.com/resetPassword

# ===== AI SERVICE CONFIGURATION =====
AI_SERVICE_URL=http://localhost:8000
AI_CHAT_API_KEY=your_ai_service_api_key
AI_MODEL_NAME=nutrition-chat
AI_TIMEOUT_MS=30000

# ===== CORS CONFIGURATION =====
# Comma-separated list of allowed origins (no wildcards in production!)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:5001

# ===== DATABASE =====
# Firestore is used as primary database (configured via Firebase)
FIRESTORE_COLLECTION_USERS=users
FIRESTORE_COLLECTION_MEALS=meals
FIRESTORE_COLLECTION_WORKOUTS=workouts
FIRESTORE_COLLECTION_WATER=water_logs

# ===== MONITORING & LOGGING =====
# Prometheus metrics (optional)
METRICS_ENABLED=1
METRICS_PORT=9090

# Structured logging
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_FILE_PATH=./logs/combined.log
LOG_ERROR_FILE_PATH=./logs/error.log

# ===== NOTIFICATIONS =====
# Push notification service
PUSH_NOTIFICATION_SERVICE=fcm
DISABLE_SCHEDULER=1

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=900000

# ===== UPLOAD CONFIGURATION =====
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
UPLOAD_PATH=./uploads

# ===== PAGINATION =====
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ===== SECURITY =====
# Bcrypt rounds for password hashing
BCRYPT_ROUNDS=10

# ===== DEVELOPMENT HELPERS =====
# Disable scheduler for local development to avoid running cron jobs
DISABLE_SCHEDULER=1

# Skip Firebase email verification
SKIP_EMAIL_VERIFICATION=true

# Trust proxy headers (set to 1 if behind a reverse proxy)
TRUST_PROXY=0

